{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "target": "ES2022",
        "module": "Node16",
        "moduleResolution": "Node16",
        "noEmit": true,
        "checkJs": true,
        "strict": true,
        "skipLibCheck": true
    },
    "include": ["index.ts", "src/**/*.ts", "src/data/*.js"],
    "exclude": ["node_modules", "data", "tmp", ".cache", "src/images", "src/lua"]
}
