{
  "name": "intyvate-wiki-data",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22.13" },
  "main": "index.ts",
  "scripts": {
    "check": "npm run check:types && npm run test:unit",
    "check:workspace": "node scripts/check_workspace.cjs",
    "test:unit": "node --import tsx --test scripts/*.test.cjs scripts/*.test.ts",
    "gen": "tsx index.ts",
    "gen:characters": "tsx scripts/generate_characters.ts",
    "gen:weapons": "tsx scripts/generate_weapons.ts",
    "gen:outfits": "tsx scripts/generate_outfits.ts",
    "check:outfits": "node --import tsx --test scripts/outfits.test.ts",
    "check:outfits:export": "tsx scripts/check_outfits.ts",
    "check:outfits:api": "tsx scripts/check_outfit_api.ts",
    "gen:npcs": "node --import tsx --import ./scripts/data_bootstrap.mts scripts/generate_npcs.ts",
    "gen:tasks": "node --import tsx --import ./scripts/data_bootstrap.mts scripts/generate_tasks.ts",
    "gen:archives": "node --import tsx --import ./scripts/data_bootstrap.mts scripts/generate_archives.ts",
    "gen:misc": "node --import tsx --import ./scripts/data_bootstrap.mts scripts/generate_misc.ts",
    "gen:maps": "tsx scripts/generate_maps.ts",
    "check:maps": "node --import tsx --test scripts/map_catalogue.test.ts scripts/map_scenes.test.ts scripts/map_directory.test.ts scripts/map_task_dependencies.test.ts scripts/map_fog.test.ts",
    "check:maps:export": "tsx scripts/check_map_export.ts",
    "check:migration": "node scripts/check_migration.cjs",
    "check:types": "tsc -p tsconfig.check.json",
    "check:contracts": "node --test scripts/generator_boundaries.test.cjs",
    "check:initialization": "node --test scripts/genshin_initialization.test.cjs",
    "check:packages": "node scripts/check_packages.cjs",
    "check:misc": "node --import tsx --import ./scripts/data_bootstrap.mts scripts/check_misc.ts",
    "check:misc:images": "node --test scripts/misc_images.test.cjs scripts/misc_image_preparation.test.cjs",
    "check:images": "tsx scripts/check_images.ts",
    "check:data-catalogues": "node --import tsx --import ./scripts/data_bootstrap.mts scripts/check_data_catalogues.ts",
    "check:category-export": "node --import tsx --import ./scripts/data_bootstrap.mts scripts/check_category_export.ts",
    "check:archive-directories": "node --import tsx --import ./scripts/data_bootstrap.mts scripts/check_archive_directories.ts",
    "check:archive-references": "node --import tsx --import ./scripts/data_bootstrap.mts scripts/check_archive_references.ts",
    "check:archive-enums": "node --import tsx --import ./scripts/data_bootstrap.mts scripts/check_archive_enums.ts",
    "check:archive-dialogues": "node --import tsx --import ./scripts/data_bootstrap.mts scripts/check_archive_dialogues.ts",
    "check:page-groups": "tsx scripts/check_page_groups.ts",
    "check:misc:api": "node --import tsx --import ./scripts/data_bootstrap.mts scripts/check_misc_api.ts",
    "check:archives": "node --import tsx --import ./scripts/data_bootstrap.mts scripts/check_archives.ts",
    "check:npcs": "node --import tsx --import ./scripts/data_bootstrap.mts scripts/check_npcs.ts",
    "check:narration": "node --import tsx --import ./scripts/data_bootstrap.mts scripts/check_narration.ts",
    "check:bubbles": "node --import tsx --import ./scripts/data_bootstrap.mts scripts/check_bubbles.ts",
    "check:bubbles:export": "node --import tsx --import ./scripts/data_bootstrap.mts scripts/check_bubbles_export.ts",
    "check:exports": "node scripts/check_exports.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inteyvat-Wiki/wiki-data.git"
  },
  "author": "Inteyvat-Wiki",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Inteyvat-Wiki/wiki-data/issues"
  },
  "homepage": "https://github.com/Inteyvat-Wiki/wiki-data#readme",
  "description": "",
  "dependencies": {
    "@inteyvat-wiki/resource-tools": "file:../Inteyvat-Wiki-resource-tools",
    "@inteyvat-wiki/wiki-contracts": "file:../Inteyvat-Wiki-contracts",
    "@types/node": "^25.6.0",
    "@types/pngjs": "^6.0.5",
    "d3-contour": "4.0.2",
    "genshin-db": "file:../genshin-db",
    "pngjs": "^7.0.0",
    "polygon-clipping": "0.15.7",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/d3-contour": "3.0.6"
  }
}
