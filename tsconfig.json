{
    "compilerOptions": {
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "~/*": [
                "./src/*"
            ],
            "~~/*": [
                "./*"
            ]
        },
        "types": ["node"],
        "resolveJsonModule": true,
        "esModuleInterop": true
    },
    "include": [
        "."
    ]
}